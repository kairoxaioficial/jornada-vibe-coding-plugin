{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/skills/jornada-vibe-coding/scripts/verificar-ferramentas.sh",
          "timeout": 20
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/skills/jornada-vibe-coding/scripts/jornada-context.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "Edit|Write|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/skills/jornada-vibe-coding/scripts/jornada-guard.sh",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Read|Grep|Glob",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/skills/jornada-vibe-coding/scripts/jornada-p1-guard.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "mcp__tokensave__.*|mcp__code-review-graph__.*",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/skills/jornada-vibe-coding/scripts/jornada-p1-marca.sh",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Edit|Write|MultiEdit|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/skills/jornada-vibe-coding/scripts/jornada-registrar-edicao.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/skills/jornada-vibe-coding/scripts/jornada-stop-guard.sh",
          "timeout": 10
        }
      ]
    }
  ]
}
